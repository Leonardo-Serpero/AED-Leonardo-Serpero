int AreDecimalDigits(char palabra[])
{ 
int devolver=1;
if(palabra[0]=='\0')
{
	devolver=0;
}
    for(int posicion=0;devolver!=0&&palabra[posicion]!='\0';posicion++)
	{
			
		if(palabra[posicion]!='\0'&&(palabra[posicion]<48||palabra[posicion]>57))
		{
			devolver=0;
		
		}
	}																										  	  																																												 																						                 
return devolver;
}










